# Normalise line endings to LF in the repository for all text files.
# Git will convert to the OS-native ending on checkout (CRLF on Windows, LF elsewhere).
* text=auto eol=lf

# Force LF for files that must never use CRLF
*.cs        text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.md        text eol=lf
*.gitignore text eol=lf

# Treat compiled output as binary (should never be committed, but just in case)
*.dll       binary
*.pdb       binary
*.nupkg     binary
