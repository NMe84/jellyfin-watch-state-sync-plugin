<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Which Jellyfin generation to build against.  Jellyfin 12 bumped the runtime,
      so the target framework follows the Jellyfin version:
        JellyfinVersion=10.11.x  ->  net9.0   (Jellyfin 10.x)
        JellyfinVersion=12.x     ->  net10.0  (Jellyfin 12)
      Build a specific variant with:  dotnet build -p:JellyfinVersion=12.0.0
    -->
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">10.11.10</JellyfinVersion>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('10.'))">net9.0</TargetFramework>
    <TargetFramework Condition="$(JellyfinVersion.StartsWith('12.'))">net10.0</TargetFramework>

    <RootNamespace>Jellyfin.Plugin.WatchSync</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.WatchSync</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ExcludeAssets="runtime" is required for all Jellyfin packages.
      Without it, the plugin DLL will try to register its own copies of
      Jellyfin assemblies and fail to load.
    -->
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model"      Version="$(JellyfinVersion)" ExcludeAssets="runtime" />
    <!--
      Newtonsoft.Json is already shipped by Jellyfin; ExcludeAssets="runtime" prevents
      bundling our own copy. We only need it at compile time to call JObject on the
      JavaScript Injector bridge.
    -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
